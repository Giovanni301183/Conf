# Copia questo file in .env.local e inserisci i valori reali.
# Supabase -> Project Settings -> API

# URL del progetto Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chiave pubblica (anon / publishable): va nel browser, sicura solo con RLS attivo
VITE_SUPABASE_ANON_KEY=

# --- SOLO server/script, MAI con prefisso VITE_ (non deve finire nel browser) ---
# Chiave service_role: serve solo per script di migrazione dati
SUPABASE_SERVICE_ROLE_KEY=

# Password del database (Supabase -> Project Settings -> Database)
SUPABASE_DB_PASSWORD=
