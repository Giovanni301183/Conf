{
 "name": "Agenda - Email Gmail",
 "nodes": [
  {
   "parameters": {
    "pollTimes": {
     "item": [
      {
       "mode": "everyMinute"
      }
     ]
    },
    "simple": false,
    "filters": {
     "q": "to:g.sorrentino+agenda@terranovasrl.net OR (from:me to:me subject:(Fwd OR I))"
    },
    "options": {
     "downloadAttachments": true,
     "dataPropertyAttachmentsPrefixName": "attachment_"
    }
   },
   "id": "01b5b536-0079-4103-bb5d-3879706893c0",
   "name": "Email in arrivo",
   "type": "n8n-nodes-base.gmailTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    200
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Agenda"
    }
   }
  },
  {
   "parameters": {
    "assignments": {
     "assignments": [
      {
       "id": "50518bb2-fedc-41f1-a332-75313cda40f6",
       "name": "url",
       "type": "string",
       "value": "https://conf-five.vercel.app/api/agenda"
      }
     ]
    },
    "includeOtherFields": true,
    "options": {}
   },
   "id": "c6a9dc55-06f3-443b-b76d-19223f8be26c",
   "name": "Impostazioni email",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    220,
    200
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $('Impostazioni email').item.json.url }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ azione: 'posta', gmail_id: $('Email in arrivo').item.json.id, da: $('Email in arrivo').item.json.from?.value?.[0]?.address || $('Email in arrivo').item.json.from?.text || '', oggetto: $('Email in arrivo').item.json.subject || '', testo: $('Email in arrivo').item.json.text || '', data: $('Email in arrivo').item.json.date || '', allegati: Object.entries($('Email in arrivo').item.binary || {}).map(([k, f]) => ({ chiave: k, nome: f.fileName || k, mime: f.mimeType || '', peso: f.fileSize || '' })) }) }}",
    "options": {}
   },
   "id": "16710c0b-9a6d-44ab-a98a-f86daa3c1c3a",
   "name": "Email → app",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    440,
    200
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "",
     "name": "Agenda - segreto"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Un elemento per ogni allegato da caricare, con il suo file preso dall'email.\nconst file = $('Email in arrivo').first().binary || {};\nconst r = $input.first().json;\nreturn (r.ok && r.caricamenti ? r.caricamenti : []).filter(c => file[c.chiave]).map(c => ({ json: c, binary: { data: file[c.chiave] } }));"
   },
   "id": "9f4daf7f-10ae-4ed3-98ad-acbdbda929db",
   "name": "Allegati da caricare",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    200
   ]
  },
  {
   "parameters": {
    "method": "PUT",
    "url": "={{ $json.url }}",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "content-type",
       "value": "={{ $json.mime }}"
      },
      {
       "name": "apikey",
       "value": "={{ $json.apikey }}"
      },
      {
       "name": "x-upsert",
       "value": "false"
      }
     ]
    },
    "sendBody": true,
    "contentType": "binaryData",
    "inputDataFieldName": "data",
    "options": {}
   },
   "id": "4ccbf39f-bf69-4423-8aee-c56194d2c2cd",
   "name": "Carica allegato",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    880,
    200
   ]
  }
 ],
