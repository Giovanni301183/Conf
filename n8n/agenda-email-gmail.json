{
 "name": "Agenda - Email Gmail",
 "nodes": [
  {
   "parameters": {
    "pollTimes": {
     "item": [
      {
       "mode": "everyMinute"
      }
     ]
    },
    "simple": false,
    "filters": {
     "q": "to:g.sorrentino+agenda@terranovasrl.net OR (from:me to:me subject:(Fwd OR I))"
    },
    "options": {
     "downloadAttachments": true,
     "dataPropertyAttachmentsPrefixName": "attachment_"
    }
   },
   "id": "85a6cdf0-c93d-4809-a842-b7a42cb7ad0b",
   "name": "Email in arrivo",
   "type": "n8n-nodes-base.gmailTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    200
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Agenda"
    }
   }
  },
  {
   "parameters": {
    "assignments": {
     "assignments": [
      {
       "id": "dbe480bb-53ec-4975-a2f1-0529a09e6517",
       "name": "url",
       "type": "string",
       "value": "https://conf-five.vercel.app/api/agenda"
      }
     ]
    },
    "includeOtherFields": true,
    "options": {}
   },
   "id": "c40d9e14-5507-4d31-830d-f9b8af507efe",
   "name": "Impostazioni email",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    220,
    200
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $('Impostazioni email').item.json.url }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ azione: 'posta', gmail_id: $('Email in arrivo').item.json.id, da: $('Email in arrivo').item.json.from?.value?.[0]?.address || $('Email in arrivo').item.json.from?.text || '', oggetto: $('Email in arrivo').item.json.subject || '', testo: $('Email in arrivo').item.json.text || '', data: $('Email in arrivo').item.json.date || '', allegati: Object.entries($('Email in arrivo').item.binary || {}).map(([k, f]) => ({ chiave: k, nome: f.fileName || k, mime: f.mimeType || '', peso: f.fileSize || '' })) }) }}",
    "options": {}
   },
   "id": "edded04d-44d7-48fd-92c4-246f07c2fc59",
   "name": "Email → app",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    440,
    200
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "",
     "name": "Agenda - segreto"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Un elemento per ogni allegato da caricare, con il suo file preso dall'email.\nconst file = $('Email in arrivo').first().binary || {};\nconst r = $input.first().json;\nreturn (r.ok && r.caricamenti ? r.caricamenti : []).filter(c => file[c.chiave]).map(c => ({ json: c, binary: { data: file[c.chiave] } }));"
   },
   "id": "e3e62624-5897-4a85-a5f0-ef2f4cd9cd4c",
   "name": "Allegati da caricare",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    200
   ]
  },
  {
   "parameters": {
    "method": "PUT",
    "url": "={{ $json.url }}",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "content-type",
       "value": "={{ $json.mime }}"
      },
      {
       "name": "apikey",
       "value": "={{ $json.apikey }}"
      },
      {
       "name": "x-upsert",
       "value": "false"
      }
     ]
    },
    "sendBody": true,
    "contentType": "binaryData",
    "inputDataFieldName": "data",
    "options": {}
   },
   "id": "4c1fc378-eff9-4fc1-a0f6-b6fa1ac9d966",
   "name": "Carica allegato",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    880,
    200
   ]
  }
 ],
