    "options": {}
   },
   "id": "aba9e290-a1c6-46b3-969f-2d76d5d79904",
   "name": "Messaggi dei fili",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    1600,
    100
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Agenda"
    }
   },
   "onError": "continueRegularOutput"
  },
  {
   "parameters": {
    "jsCode": "// Tutte le email trovate (etichettate e delle conversazioni legate), con conversazione e data, per chiedere all'app quali leggere.\nconst ms = m => Number(m.internalDate) || Date.parse(m.date || (m.headers && m.headers.date) || (((m.payload && m.payload.headers) || []).find(h => /^date$/i.test(h.name)) || {}).value || '') || 0;\nconst piatti = xs => xs.flatMap(x => Array.isArray(x.messages) ? x.messages : [x]);\nlet tutti = $('Email con etichetta').all().map(i => i.json);\ntry { tutti = tutti.concat(piatti($('Messaggi dei fili').all().map(i => i.json))); } catch (e) {}\nreturn [{ json: { email: tutti.filter(m => m && m.id).map(m => ({ id: m.id, thread: m.threadId || '', data: ms(m) })) } }];"
   },
   "id": "e007715f-7857-4d75-b061-3ed89b11dc55",
   "name": "Raccogli",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1800,
