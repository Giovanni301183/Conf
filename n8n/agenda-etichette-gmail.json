   "id": "b7aeae3b-20e4-4eb3-ba3d-833f3d87ba2b",
   "name": "Quali leggere",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    2000,
    200
   ],
   "credentials": {
