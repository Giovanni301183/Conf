   "id": "8e473819-311a-46a1-a48a-3a0e438e4cac",
   "name": "Quali leggere",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    2000,
    200
   ],
   "credentials": {
