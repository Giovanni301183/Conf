   "id": "6aff6a0a-6def-41c1-bae9-07afa3f6831b",
   "name": "Impostazioni etichette",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    200,
    200
   ]
  },
  {
   "parameters": {
    "resource": "label",
    "returnAll": true
   },
   "id": "703cd616-abdd-45ab-876f-38e59cda32eb",
   "name": "Etichette Gmail",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    400,
    200
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Agenda"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Ricerca Gmail delle email con un'etichetta «Conf/…» non ancora passate all'app (anche vecchie), e nomi delle etichette per l'app.\nconst ll = $input.all().map(i => i.json);\nconst conf = ll.filter(l => /^conf\\//i.test(l.name || ''));\nconst fatta = conf.find(l => /in app/i.test(l.name)), errore = conf.find(l => /non entrata/i.test(l.name));\nconst lab = n => 'label:' + n.toLowerCase().replace(/[\\s\\/]+/g, '-');\nconst cerca = conf.filter(l => l !== fatta && l !== errore);\nif (!fatta || !cerca.length) return [];\nreturn [{ json: { q: '{' + cerca.map(l => lab(l.name)).join(' ') + '} -' + lab(fatta.name) + (errore ? ' -' + lab(errore.name) : ''),\n  nomi: Object.fromEntries(conf.map(l => [l.id, l.name])), fatta: fatta.id, errore: (errore || fatta).id } }];"
   },
   "id": "51321d60-a0d9-47f7-8c71-d5c5c96d47ae",
   "name": "Ricerca etichette",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    600,
    200
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $('Impostazioni etichette').first().json.url }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ azione: 'fili' }) }}",
    "options": {}
   },
   "id": "43c5901f-8888-4b97-9298-cd4f045bb88c",
   "name": "Fili attivi",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    800,
    200
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "",
     "name": "Agenda - segreto"
    }
   }
  },
  {
   "parameters": {
    "operation": "getAll",
    "limit": 30,
    "filters": {
     "q": "={{ $('Ricerca etichette').first().json.q }}"
    }
   },
   "id": "140da962-e19d-43a7-b4a1-ba204a24ad78",
   "name": "Email con etichetta",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    1000,
    200
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Agenda"
    }
   },
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "jsCode": "// Una riga per ogni conversazione legata a una voce aperta (le dà l'app); nessuna = si passa oltre.\nconst ff = $('Fili attivi').first().json.fili || [];\nreturn ff.length ? ff.map(t => ({ json: { thread: t } })) : [{ json: { nessuno: true } }];"
   },
   "id": "4083ab23-6aca-405a-9ab2-516e14e027b2",
   "name": "Fili da guardare",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1200,
    200
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "24994b43-7205-4f1d-8bc2-2e74f2309d60",
       "leftValue": "={{ !$json.nessuno }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "id": "6521ed2e-fc11-4915-8c55-2ae06909a1e0",
   "name": "Ci sono fili?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1400,
    200
   ]
  },
  {
   "parameters": {
    "resource": "thread",
