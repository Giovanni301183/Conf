   },
   "id": "5325ad7d-3e03-40e5-83ca-dee3cfc2ff39",
   "name": "Segna in Gmail",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    2800,
    100
   ],
   "credentials": {
