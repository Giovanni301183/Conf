   "id": "96acdc21-efd5-4fab-87f9-092b3988b34e",
   "name": "Impostazioni etichette",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    200,
    200
   ]
  },
  {
   "parameters": {
    "resource": "label",
    "returnAll": true
   },
   "id": "92718d40-1f3f-4a67-9375-00e76f44eeac",
   "name": "Etichette Gmail",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    400,
    200
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Agenda"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Ricerca Gmail delle email con un'etichetta «Conf/…» non ancora passate all'app (anche vecchie), e nomi delle etichette per l'app.\nconst ll = $input.all().map(i => i.json);\nconst conf = ll.filter(l => /^conf\\//i.test(l.name || ''));\nconst fatta = conf.find(l => /in app/i.test(l.name)), errore = conf.find(l => /non entrata/i.test(l.name));\nconst lab = n => 'label:' + n.toLowerCase().replace(/[\\s\\/]+/g, '-');\nconst cerca = conf.filter(l => l !== fatta && l !== errore);\nif (!fatta || !cerca.length) return [];\nreturn [{ json: { q: '{' + cerca.map(l => lab(l.name)).join(' ') + '} -' + lab(fatta.name) + (errore ? ' -' + lab(errore.name) : ''),\n  nomi: Object.fromEntries(conf.map(l => [l.id, l.name])), fatta: fatta.id, errore: (errore || fatta).id } }];"
   },
   "id": "12f71385-16a6-4369-9a62-a18df5c25f39",
   "name": "Ricerca etichette",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    600,
    200
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $('Impostazioni etichette').first().json.url }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ azione: 'fili' }) }}",
    "options": {}
   },
   "id": "f8781359-5e91-44ed-b7a4-b16ab90e6ca8",
   "name": "Fili attivi",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    800,
    200
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "",
     "name": "Agenda - segreto"
    }
   }
  },
  {
   "parameters": {
    "operation": "getAll",
    "limit": 30,
    "filters": {
     "q": "={{ $('Ricerca etichette').first().json.q }}"
    }
   },
   "id": "d15661db-c49b-49e2-8730-e59da30d1a87",
   "name": "Email con etichetta",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    1000,
    200
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Agenda"
    }
   },
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "jsCode": "// Una riga per ogni conversazione legata a una voce aperta (le dà l'app); nessuna = si passa oltre.\nconst ff = $('Fili attivi').first().json.fili || [];\nreturn ff.length ? ff.map(t => ({ json: { thread: t } })) : [{ json: { nessuno: true } }];"
   },
   "id": "2a503c4e-3bb7-43fd-80dd-b6df014e5bff",
   "name": "Fili da guardare",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1200,
    200
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "2fc9a36f-0a72-487a-acf4-05660757894e",
       "leftValue": "={{ !$json.nessuno }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "id": "c63564af-9b2a-4af2-9223-353d2da10eb9",
   "name": "Ci sono fili?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1400,
    200
   ]
  },
  {
   "parameters": {
    "resource": "thread",
    "operation": "get",
    "threadId": "={{ $json.thread }}",
    "options": {}
   },
   "id": "f46306ab-bf02-4e51-a805-7ee134314a42",
   "name": "Messaggi dei fili",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    1600,
    100
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Agenda"
    }
   },
   "onError": "continueRegularOutput"
  },
  {
   "parameters": {
    "jsCode": "// Tutte le email trovate (etichettate e delle conversazioni legate), con conversazione e data, per chiedere all'app quali leggere.\nconst ms = m => Number(m.internalDate) || Date.parse(m.date || (m.headers && m.headers.date) || (((m.payload && m.payload.headers) || []).find(h => /^date$/i.test(h.name)) || {}).value || '') || 0;\nconst piatti = xs => xs.flatMap(x => Array.isArray(x.messages) ? x.messages : [x]);\nlet tutti = $('Email con etichetta').all().map(i => i.json);\ntry { tutti = tutti.concat(piatti($('Messaggi dei fili').all().map(i => i.json))); } catch (e) {}\nreturn [{ json: { email: tutti.filter(m => m && m.id).map(m => ({ id: m.id, thread: m.threadId || '', data: ms(m) })) } }];"
   },
   "id": "c44ca7c0-83bf-41b2-b7ec-fc659f5e8a74",
   "name": "Raccogli",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1800,
    200
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $('Impostazioni etichette').first().json.url }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ azione: 'posta_nuove', email: $json.email }) }}",
