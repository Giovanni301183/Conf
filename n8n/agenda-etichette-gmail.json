{
 "name": "Agenda - Etichette Gmail",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "minutes",
       "minutesInterval": 1
      }
     ]
    }
   },
   "id": "f7078c99-6f20-4233-bdda-2d6a1b4af40e",
   "name": "Ogni minuto",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    200
   ]
  },
  {
   "parameters": {
    "resource": "label",
    "returnAll": true
   },
   "id": "5be71139-8bac-4e9a-815d-87905e819720",
   "name": "Etichette Gmail",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    220,
    200
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Agenda"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Ricerca Gmail delle email con un'etichetta «Conf/…» non ancora passate all'app, e nomi delle etichette per l'app.\nconst ll = $input.all().map(i => i.json);\nconst conf = ll.filter(l => /^conf\\//i.test(l.name || ''));\nconst fatta = conf.find(l => /in app/i.test(l.name)), errore = conf.find(l => /non entrata/i.test(l.name));\nconst lab = n => 'label:' + n.toLowerCase().replace(/[\\s\\/]+/g, '-');\nconst nostre = conf.filter(l => l !== fatta && l !== errore);\nif (!fatta || !nostre.length) return [];\nreturn [{ json: { q: '{' + nostre.map(l => lab(l.name)).join(' ') + '} -' + lab(fatta.name) + (errore ? ' -' + lab(errore.name) : ''),\n  nomi: Object.fromEntries(conf.map(l => [l.id, l.name])), fatta: fatta.id, errore: (errore || fatta).id } }];"
   },
   "id": "59c36a77-e855-49ed-b0a5-cc0fbd1b3f34",
   "name": "Ricerca etichette",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    200
   ]
  },
  {
   "parameters": {
    "operation": "getAll",
    "limit": 1,
    "simple": false,
    "filters": {
     "q": "={{ $json.q }}"
    },
    "options": {
     "downloadAttachments": true,
     "dataPropertyAttachmentsPrefixName": "attachment_"
    }
   },
   "id": "64720b71-488f-4833-8fc8-d6d3c8ae0c01",
   "name": "Email etichettata",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    660,
    200
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Agenda"
    }
   }
  },
  {
   "parameters": {
    "assignments": {
     "assignments": [
      {
       "id": "1e3f0586-9fbd-49cb-ae1b-438e17dfc6b6",
       "name": "url",
       "type": "string",
       "value": "https://conf-five.vercel.app/api/agenda"
      },
      {
       "id": "74309e0c-4ac4-4c11-ae0a-01ef09c16b49",
       "name": "casella",
       "type": "string",
       "value": "g.sorrentino@terranovasrl.net"
      }
     ]
    },
    "includeOtherFields": true,
    "options": {}
   },
   "id": "7531217e-f329-4c0e-b008-63f709739453",
   "name": "Impostazioni etichette",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    880,
    200
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $('Impostazioni etichette').item.json.url }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ azione: 'posta', per: $('Impostazioni etichette').item.json.casella, gmail_id: $('Email etichettata').item.json.id, thread_id: $('Email etichettata').item.json.threadId || '', da: $('Email etichettata').item.json.from?.value?.[0]?.address || $('Email etichettata').item.json.from?.text || '', a: $('Email etichettata').item.json.to?.value?.[0]?.address || '', oggetto: $('Email etichettata').item.json.subject || '', testo: $('Email etichettata').item.json.text || '', data: $('Email etichettata').item.json.date || '', etichette_gmail: ($('Email etichettata').item.json.labelIds || []).map(id => $('Ricerca etichette').item.json.nomi[id]).filter(Boolean), allegati: Object.entries($('Email etichettata').item.binary || {}).map(([k, f]) => ({ chiave: k, nome: f.fileName || k, mime: f.mimeType || '', peso: f.fileSize || '' })) }) }}",
    "options": {}
   },
   "id": "ccedcf75-6ae6-47ae-bedf-4fdc26d98bd8",
   "name": "Etichettata → app",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1100,
    200
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "",
     "name": "Agenda - segreto"
    }
   }
  },
  {
   "parameters": {
    "operation": "addLabels",
    "messageId": "={{ $('Email etichettata').item.json.id }}",
    "labelIds": "={{ $json.ok ? $('Ricerca etichette').item.json.fatta : $('Ricerca etichette').item.json.errore }}"
   },
   "id": "483d4a32-52f6-4579-90a8-b155c4f3ffd3",
   "name": "Segna in Gmail",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    1320,
    100
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Agenda"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Un elemento per ogni allegato da caricare, con il suo file preso dall'email.\nconst file = $('Email etichettata').first().binary || {};\nconst r = $input.first().json;\nreturn (r.ok && r.caricamenti ? r.caricamenti : []).filter(c => file[c.chiave]).map(c => ({ json: c, binary: { data: file[c.chiave] } }));"
   },
   "id": "02236c33-caf3-48ce-8c7a-38723a4b2d7e",
   "name": "Allegati etichettata",
   "type": "n8n-nodes-base.code",
