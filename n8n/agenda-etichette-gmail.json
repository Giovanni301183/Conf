    "returnAll": true
   },
   "id": "e05a6f6b-a161-4da8-936f-639aa11926bc",
   "name": "Etichette Gmail",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    400,
    200
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Agenda"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Ricerca Gmail delle email con un'etichetta «Conf/…» non ancora passate all'app (anche vecchie), e nomi delle etichette per l'app.\nconst ll = $input.all().map(i => i.json);\nconst conf = ll.filter(l => /^conf\\//i.test(l.name || ''));\nconst fatta = conf.find(l => /in app/i.test(l.name)), errore = conf.find(l => /non entrata/i.test(l.name));\nconst lab = n => 'label:' + n.toLowerCase().replace(/[\\s\\/]+/g, '-');\nconst cerca = conf.filter(l => l !== fatta && l !== errore);\nif (!fatta || !cerca.length) return [];\nreturn [{ json: { q: '{' + cerca.map(l => lab(l.name)).join(' ') + '} -' + lab(fatta.name) + (errore ? ' -' + lab(errore.name) : ''),\n  nomi: Object.fromEntries(conf.map(l => [l.id, l.name])), fatta: fatta.id, errore: (errore || fatta).id } }];"
   },
   "id": "4e109cfd-c56f-404b-823c-bae6ff56cfdf",
   "name": "Ricerca etichette",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    600,
    200
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $('Impostazioni etichette').first().json.url }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ azione: 'fili' }) }}",
    "options": {}
   },
   "id": "755caf87-4749-4cf9-bc2e-1a40139d2290",
   "name": "Fili attivi",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    800,
    200
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "",
     "name": "Agenda - segreto"
    }
   }
  },
  {
   "parameters": {
    "operation": "getAll",
    "limit": 30,
    "filters": {
     "q": "={{ $('Ricerca etichette').first().json.q }}"
    }
   },
   "id": "6173e525-875a-4fee-99f3-eb561a75b6fe",
   "name": "Email con etichetta",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    1000,
    200
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Agenda"
    }
   },
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "jsCode": "// Una riga per ogni conversazione legata a una voce aperta (le dà l'app); nessuna = si passa oltre.\nconst ff = $('Fili attivi').first().json.fili || [];\nreturn ff.length ? ff.map(t => ({ json: { thread: t } })) : [{ json: { nessuno: true } }];"
   },
   "id": "2855abda-122c-464e-b3e2-39badfecfecd",
   "name": "Fili da guardare",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1200,
    200
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "c62453e2-b005-4066-8c4a-e8e0318dbbb9",
       "leftValue": "={{ !$json.nessuno }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "id": "19c3676d-cf26-41fe-b4ec-14b9b5ad995b",
   "name": "Ci sono fili?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1400,
    200
   ]
  },
  {
   "parameters": {
    "resource": "thread",
