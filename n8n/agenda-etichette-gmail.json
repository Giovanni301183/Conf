   },
   "id": "6e16faab-ed8a-49e2-8b94-e870a7046bcb",
   "name": "Segna in Gmail",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    2800,
    100
   ],
   "credentials": {
    "gmailOAuth2": {
