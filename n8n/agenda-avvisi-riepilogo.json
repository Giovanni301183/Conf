    }
   }
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "0c7667a3-cae3-4d23-a522-66546aea2aa1",
       "leftValue": "={{ $json.ok && $json.invia }}",
       "rightValue": "",
