          }
         },
         {
          "text": "✅ Risolto",
          "additionalFields": {
           "callback_data": "=risolvi:{{ $json.id }}"
          }
         }
        ]
       }
      }
     ]
    },
    "additionalFields": {
     "appendAttribution": false
    }
