    }
   }
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "6271af76-0bf2-46c9-b77b-025fd5862f3d",
       "leftValue": "={{ $json.ok && $json.invia }}",
       "rightValue": "",
