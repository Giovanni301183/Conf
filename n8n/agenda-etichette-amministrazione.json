   "id": "0ef81021-fc0f-49d1-b7f0-582dea692681",
   "name": "Messaggi dei fili (amm.)",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    1600,
    600
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Amministrazione"
    }
   },
   "onError": "continueRegularOutput"
  },
  {
   "parameters": {
    "jsCode": "// Tutte le email trovate (etichettate e delle conversazioni legate), con conversazione e data, per chiedere all'app quali leggere.\nconst ms = m => Number(m.internalDate) || Date.parse(m.date || (m.headers && m.headers.date) || (((m.payload && m.payload.headers) || []).find(h => /^date$/i.test(h.name)) || {}).value || '') || 0;\nconst piatti = xs => xs.flatMap(x => Array.isArray(x.messages) ? x.messages : [x]);\nlet tutti = $('Email con etichetta (amm.)').all().map(i => i.json);\ntry { tutti = tutti.concat(piatti($('Messaggi dei fili (amm.)').all().map(i => i.json))); } catch (e) {}\nreturn [{ json: { email: tutti.filter(m => m && m.id).map(m => ({ id: m.id, thread: m.threadId || '', data: ms(m) })) } }];"
   },
