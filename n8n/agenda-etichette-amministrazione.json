   "id": "683f10cb-07b9-448e-86d1-218cf4b2d485",
   "name": "Impostazioni etichette (amm.)",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    200,
    700
   ]
