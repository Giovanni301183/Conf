   },
   "id": "26968a91-47cd-46fc-b26b-10f7e41b69f0",
   "name": "Etichette Gmail (amm.)",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    400,
    700
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Amministrazione"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Ricerca Gmail delle email con un'etichetta «Conf/…» non ancora passate all'app (anche vecchie), e nomi delle etichette per l'app.\nconst ll = $input.all().map(i => i.json);\nconst conf = ll.filter(l => /^conf\\//i.test(l.name || ''));\nconst fatta = conf.find(l => /in app/i.test(l.name)), errore = conf.find(l => /non entrata/i.test(l.name));\nconst lab = n => 'label:' + n.toLowerCase().replace(/[\\s\\/]+/g, '-');\nconst cerca = conf.filter(l => l !== fatta && l !== errore);\nif (!fatta || !cerca.length) return [];\nreturn [{ json: { q: '{' + cerca.map(l => lab(l.name)).join(' ') + '} -' + lab(fatta.name) + (errore ? ' -' + lab(errore.name) : ''),\n  nomi: Object.fromEntries(conf.map(l => [l.id, l.name])), fatta: fatta.id, errore: (errore || fatta).id } }];"
   },
   "id": "024cf5bd-bdf1-4879-8981-e1a1bc89a370",
   "name": "Ricerca etichette (amm.)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    600,
    700
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $('Impostazioni etichette (amm.)').first().json.url }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ azione: 'fili' }) }}",
    "options": {}
   },
   "id": "711e1f99-6754-479e-a0d6-35bfd0ccce82",
   "name": "Fili attivi (amm.)",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    800,
    700
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "",
     "name": "Agenda - segreto"
    }
   }
  },
  {
   "parameters": {
    "operation": "getAll",
    "limit": 30,
    "filters": {
     "q": "={{ $('Ricerca etichette (amm.)').first().json.q }}"
    }
   },
   "id": "3a212b44-6b69-4556-b967-60ccd6554150",
   "name": "Email con etichetta (amm.)",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    1000,
    700
   ],
   "credentials": {
    "gmailOAuth2": {
     "id": "",
     "name": "Gmail Amministrazione"
    }
   },
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "jsCode": "// Una riga per ogni conversazione legata a una voce aperta (le dà l'app); nessuna = si passa oltre.\nconst ff = $('Fili attivi (amm.)').first().json.fili || [];\nreturn ff.length ? ff.map(t => ({ json: { thread: t } })) : [{ json: { nessuno: true } }];"
   },
   "id": "64a0e0c7-5de0-4a7b-8621-2d01f35ed5aa",
   "name": "Fili da guardare (amm.)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1200,
    700
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "2fc9a36f-0a72-487a-acf4-05660757894e",
       "leftValue": "={{ !$json.nessuno }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "id": "ac9adf2c-feec-42e6-b123-a54e5c571d59",
   "name": "Ci sono fili? (amm.)",
