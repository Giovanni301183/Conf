    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ azione: 'posta', per: $('Impostazioni etichette (amm.)').first().json.utente || $('Impostazioni etichette (amm.)').first().json.casella, casella: $('Impostazioni etichette (amm.)').first().json.casella, gmail_id: $('Email etichettata (amm.)').first().json.id, thread_id: $('Email etichettata (amm.)').first().json.threadId || '', da: $('Email etichettata (amm.)').first().json.from?.value?.[0]?.address || $('Email etichettata (amm.)').first().json.from?.text || '', a: $('Email etichettata (amm.)').first().json.to?.value?.[0]?.address || '', oggetto: $('Email etichettata (amm.)').first().json.subject || '', testo: $('Email etichettata (amm.)').first().json.text || '', data: $('Email etichettata (amm.)').first().json.date || '', data_ms: Number($('Email etichettata (amm.)').first().json.internalDate) || 0, etichette_gmail: ($('Email etichettata (amm.)').first().json.labelIds || []).map(id => $('Ricerca etichette (amm.)').first().json.nomi[id]).filter(Boolean), allegati: Object.entries($('Email etichettata (amm.)').first().binary || {}).map(([k, f]) => ({ chiave: k, nome: f.fileName || k, mime: f.mimeType || '', peso: f.fileSize || '' })) }) }}",
    "options": {}
