      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "3acbf644-3b08-4434-a164-2dc0d51c5555",
       "leftValue": "={{ !$json.nessuno }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "id": "a051b64f-a1a1-4d0a-9bac-106ad2cf3644",
   "name": "Ci sono fili? (amm.)",
   "type": "n8n-nodes-base.if",
